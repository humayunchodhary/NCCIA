APP_NAME=NCCIA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nccia.real-erp.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=realerp_nccia
DB_USERNAME=realerp_nccia
DB_PASSWORD=W5[GZ3_!OCp8

SESSION_DRIVER=database
# For 1–10 lakh records / higher concurrency, switch to redis (requires php-redis on server):
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.nccia.real-erp.net
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# OTP: iwhost blocks smtp.gmail.com (cert becomes decloud.iwhost.org).
# Use a cPanel mailbox OR sendmail — NOT Gmail SMTP.
MAIL_MAILER=sendmail
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=noreply@nccia.real-erp.net
MAIL_PASSWORD=your-cpanel-email-password
MAIL_FROM_ADDRESS=noreply@nccia.real-erp.net
MAIL_FROM_NAME="NCCIA Portal"


SANCTUM_STATEFUL_DOMAINS=nccia.real-erp.net,www.nccia.real-erp.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ADP PDF extract service (Python FastAPI on same server or local machine)
ADP_API_URL=http://127.0.0.1:8001
ADP_API_TIMEOUT=120

# PDF import OCR — path to python with pymupdf + tesseract/easyocr installed
PDF_EXTRACT_PYTHON=python3
PDF_OCR_MAX_PAGES=3
# Node tesseract.js fallback (jailshell / low disk — bash scripts/setup-ocr-lite.sh)
PDF_OCR_NODE=
PDF_OCR_NODE_MODULES=
# false = use queue workers (required for large batches)
PDF_IMPORT_SYNC=false

# ---------------------------------------------------------------------------
# SMS Gateway (Local Pakistani providers: Jazz / Telenor / Ufone / Zong)
# ---------------------------------------------------------------------------
# Master switch: false = log only, never hit the gateway (safe for testing).
SMS_ENABLED=false
SMS_PROVIDER=generic
# Gateway endpoint the provider gave you. Examples:
#   https://api.sms.com.pk/sms.aspx
#   https://sendpk.com/api/sms.php
#   https://www.sms4everyone.com/api/smsapi.aspx
SMS_API_URL=
# get or post
SMS_HTTP_METHOD=get
SMS_API_KEY=
SMS_USERNAME=
SMS_PASSWORD=
SMS_ROUTE_ID=
SMS_SENDER_ID=NCCIA
# Substring expected in a success response, e.g. "ok" or "1" or "success".
# Leave empty to skip response validation.
SMS_SUCCESS_MATCH=
SMS_TIMEOUT=15
